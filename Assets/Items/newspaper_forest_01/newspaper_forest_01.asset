  m_Name: newspaper_forest_01
  m_EditorClassIdentifier: Assembly-CSharp::Assets.Scripts.NewspaperData
  newspaperId: 0001AFB3
  inventoryIcon: {fileID: 88372273, guid: 4ed37f7509415a9499cd48d35f528fea, type: 3}
  newspaperImage: {fileID: 353121426, guid: b8c5070fca475bd459bb034e51c45f24, type: 3}
  newspaperImageUkr: {fileID: -1376196343, guid: e263a12a0d8ddd645afa6e2b50990f53, type: 3}
  newspaperName: Newspaper in the barn
  title: Mysterious Disappearance of People
  content: "January 12, 1950\n\nThere have been an increasing number of cases of
    people going missing in the city of ***. As of ***, *** people have gone missing.
    Residents are complaining about the lack of action from the city government.
    \r\n\r\n As a reminder, in early spring of this year, there were reports of unknown
    incidents that led to the disappearance of people. Since then, no action has
    been taken, and no one has been found.\n\nWe have spoken to the families of the
    missing people. It would be possible to assume that these are just coincidences,
    but there have been too many victims. \n\nAmong the missing is a married couple
    with children. Their neighbors claim that they saw the couple the day before
    their disappearance, as they were planning an evening walk and never returned."
  newspaperNameUkr: "\u0413\u0430\u0437\u0435\u0442\u0430 \u0432 \u0441\u0430\u0440\u0430\u0457"
  titleUkr: "\u0417\u0430\u0433\u0430\u0434\u043A\u043E\u0432\u0435 \u0437\u043D\u0438\u043A\u043D\u0435\u043D\u043D\u044F
    \u043B\u044E\u0434\u0435\u0439"
  contentUkr: "12 \u0441\u0456\u0447\u043D\u044F 1950 \u0440\u043E\u043A\u0443\n\n\u041F\u043E\u0447\u0430\u0441\u0442\u0456\u0448\u0430\u043B\u0438
    \u0432\u0438\u043F\u0430\u0434\u043A\u0438 \u043F\u0440\u043E\u043F\u0430\u0436\u0456
    \u043B\u044E\u0434\u0435\u0439 \u0432 \u043C\u0456\u0441\u0442\u0456 ***. \u0421\u0442\u0430\u043D\u043E\u043C
    \u043D\u0430 *** \u0434\u0435\u043D\u044C \u043F\u0440\u043E\u043F\u0430\u043B\u043E
    * * * \u043B\u044E\u0434\u0435\u0439. \u0416\u0438\u0442\u0435\u043B\u0456 \u0441\u043A\u0430\u0440\u0436\u0430\u0442\u044C\u0441\u044F
    \u043D\u0430 \u0431\u0435\u0437\u0434\u0456\u044F\u043B\u044C\u043D\u0456\u0441\u0442\u044C
    \u043C\u0435\u0440\u0456\u0457 \u043C\u0456\u0441\u0442\u0430. \n\n\u041D\u0430\u0433\u0430\u0434\u0430\u0454\u043C\u043E,
    \u0449\u043E \u043D\u0430 \u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0432\u0435\u0441\u043D\u0438
    \u0446\u044C\u043E\u0433\u043E \u0440\u043E\u043A\u0443 \u0437'\u044F\u0432\u0438\u043B\u0438\u0441\u044F
    \u043D\u043E\u0432\u0438\u043D\u0438 \u043F\u0440\u043E \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0456
    \u043F\u043E\u0434\u0456\u0457, \u0443 \u0437\u0432'\u044F\u0437\u043A\u0443\n\u0437
    \u044F\u043A\u0438\u043C\u0438, \u043F\u043E\u0447\u0430\u043B\u0438 \u043F\u0440\u043E\u043F\u0430\u0434\u0430\u0442\u0438
    \u043B\u044E\u0434\u0438. \u0417 \u0442\u043E\u0433\u043E \u0447\u0430\u0441\u0443
    \u043D\u0435 \u0431\u0443\u043B\u0438 \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u0456
    \u043D\u0430\u043B\u0435\u0436\u043D\u0456 \u0437\u0430\u0445\u043E\u0434\u0438
    \u0456 \u0436\u043E\u0434\u043D\u0430 \u043B\u044E\u0434\u0438\u043D\u0430 \u0442\u0430\u043A
    \u0456 \u043D\u0435 \u0431\u0443\u043B\u0430 \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0430.\n\n\u041C\u0438
    \u043F\u043E\u0441\u043F\u0456\u043B\u043A\u0443\u0432\u0430\u043B\u0438\u0441\u044F
    \u0437 \u0441\u0456\u043C'\u044F\u043C\u0438 \u0437\u043D\u0438\u043A\u043B\u0438\u0445
    \u043B\u044E\u0434\u0435\u0439. \u041C\u043E\u0436\u043D\u0430 \u0431\u0443\u043B\u043E
    \u0431 \u043F\u0440\u0438\u043F\u0443\u0441\u0442\u0438\u0442\u0438, \u0449\u043E
    \u0446\u0435 \u0432\u0441\u044C\u043E\u0433\u043E \u043B\u0438\u0448\u0435 \u0437\u0431\u0456\u0433\u0438,
    \u0430\u043B\u0435 \u0436\u0435\u0440\u0442\u0432 \u0441\u0442\u0430\u043B\u043E
    \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0431\u0430\u0433\u0430\u0442\u043E.
    \u0421\u0435\u0440\u0435\u0434 \u0437\u043D\u0438\u043A\u043B\u0438\u0445 \u0442\u0430\u043A\u043E\u0436
    \u0447\u0438\u0441\u043B\u0438\u0442\u044C\u0441\u044F \u0441\u0456\u043C\u0435\u0439\u043D\u0430
    \u043F\u0430\u0440\u0430, \u0443 \u044F\u043A\u0438\u0445 \u0454 \u0434\u0456\u0442\u0438.\n\n\u0407\u0445\u043D\u0456
    \u0441\u0443\u0441\u0456\u0434\u0438 \u0441\u0442\u0432\u0435\u0440\u0434\u0436\u0443\u044E\u0442\u044C,
    \u0449\u043E \u0431\u0430\u0447\u0438\u043B\u0438 \u043F\u0430\u0440\u0443 \u0437\u0430
    \u0434\u0435\u043D\u044C \u0434\u043E \u0457\u0445 \u0437\u043D\u0438\u043A\u043D\u0435\u043D\u043D\u044F,
    \u0432\u043E\u043D\u0438 \u0437\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044F
    \u043D\u0430 \u0432\u0435\u0447\u0456\u0440\u043D\u044E \u043F\u0440\u043E\u0433\u0443\u043B\u044F\u043D\u043A\u0443
    \u0456 \u0442\u0430\u043A \u0456 \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044F."
