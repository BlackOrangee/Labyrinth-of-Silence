  newspaperImageUkr: {fileID: 987365448, guid: a1a52b26b3e452445bac9a740ec38172, type: 3}
  newspaperName: Document 3
  title: Top secret experiment resume
  content: "\u2116:  0994\n\nRisks:\nHigh mortality rate\n\nMutations:\nThree times
    the original size of the subject, \nbloating, skin color and strength change
    (Similar to  ...), and limb and head shape change. The subject stops understanding
    human speech and becomes uncontrollable. Especially dangerous\n\nResults:\nThe
    object remains in a stable state. Easily transferred all stages, but began to
    show aggression. It is necessary to close the ego further from others. In no
    case do not approach him closer than 3 meters without protection or with other
    subjects!"
  newspaperNameUkr: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442 3"
  titleUkr: "\u0426\u0456\u043B\u043A\u043E\u043C \u0442\u0430\u0454\u043C\u043D\u0438\u0439
    \u0435\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442"
  contentUkr: "\u2116:  0994\n\n\u0420\u0438\u0437\u0438\u043A\u0438:\n\u0412\u0438\u0441\u043E\u043A\u0430
    \u0441\u043C\u0435\u0440\u0442\u043D\u0456\u0441\u0442\u044C\n\n\u041C\u0443\u0442\u0430\u0446\u0456\u0457:\n\u0423\u0442\u0440\u0438\u0447\u0456
    \u0431\u0456\u043B\u044C\u0448\u0438\u0439 \u0437\u0430 \u043F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u0438\u0439
    \u0440\u043E\u0437\u043C\u0456\u0440 \u043E\u0431'\u0454\u043A\u0442\u0430, \u0437\u0434\u0443\u0442\u0442\u044F
    \u0436\u0438\u0432\u043E\u0442\u0430,\n\u0437\u043C\u0456\u043D\u0430 \u043A\u043E\u043B\u044C\u043E\u0440\u0443
    \u0442\u0430 \u043C\u0456\u0446\u043D\u043E\u0441\u0442\u0456 \u0448\u043A\u0456\u0440\u0438
    (\u043F\u043E\u0434\u0456\u0431\u043D\u043E \u0434\u043E ...), \u0430 \u0442\u0430\u043A\u043E\u0436
    \u0437\u043C\u0456\u043D\u0430 \u0444\u043E\u0440\u043C\u0438 \u043A\u0456\u043D\u0446\u0456\u0432\u043E\u043A
    \u0442\u0430 \u0433\u043E\u043B\u043E\u0432\u0438. \u0421\u0443\u0431'\u0454\u043A\u0442
    \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0454 \u0440\u043E\u0437\u0443\u043C\u0456\u0442\u0438
    \u043B\u044E\u0434\u0441\u044C\u043A\u0443 \u043C\u043E\u0432\u0443 \u0442\u0430
    \u0441\u0442\u0430\u0454 \u043D\u0435\u043A\u0435\u0440\u043E\u0432\u0430\u043D\u0438\u043C.
    \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439\n\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:\n\u041E\u0431'\u0454\u043A\u0442
    \u0437\u0430\u043B\u0438\u0448\u0430\u0454\u0442\u044C\u0441\u044F \u0443 \u0441\u0442\u0430\u0431\u0456\u043B\u044C\u043D\u043E\u043C\u0443
    \u0441\u0442\u0430\u043D\u0456. \u041B\u0435\u0433\u043A\u043E \u043F\u0435\u0440\u0435\u043D\u0456\u0441
    \u0443\u0441\u0456 \u0441\u0442\u0430\u0434\u0456\u0457, \u0430\u043B\u0435 \u043F\u043E\u0447\u0430\u0432
    \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0442\u0438 \u0430\u0433\u0440\u0435\u0441\u0456\u044E.
    \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0437\u0430\u043A\u0440\u0438\u0442\u0438
    \u0435\u0433\u043E \u0434\u0430\u043B\u0456 \u0432\u0456\u0434 \u043E\u0442\u043E\u0447\u0443\u044E\u0447\u0438\u0445.
    \u041D\u0456 \u0432 \u044F\u043A\u043E\u043C\u0443 \u0440\u0430\u0437\u0456 \u043D\u0435
    \u043D\u0430\u0431\u043B\u0438\u0436\u0430\u0439\u0442\u0435\u0441\u044F \u0434\u043E
    \u043D\u044C\u043E\u0433\u043E \u0431\u043B\u0438\u0436\u0447\u0435 \u043D\u0456\u0436
    \u043D\u0430 3 \u043C\u0435\u0442\u0440\u0438 \u0431\u0435\u0437 \u0437\u0430\u0445\u0438\u0441\u0442\u0443
    \u0430\u0431\u043E \u0437 \u0456\u043D\u0448\u0438\u043C\u0438 \u043F\u0456\u0434\u0434\u043E\u0441\u043B\u0456\u0434\u043D\u0438\u043C\u0438!"
